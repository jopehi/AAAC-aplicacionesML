[Unit]
Description=Weblog ML detection dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admon
WorkingDirectory=/04-ML-deteccion-accesos-weblogs
ExecStart=/04-ML-deteccion-accesos-weblogs/.venv/bin/streamlit run app/app.py --server.address 0.0.0.0 --server.port 8503 --server.headless true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
